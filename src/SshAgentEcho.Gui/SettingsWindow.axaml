<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SshAgentEcho.Gui.SettingsWindow"
        xmlns:vm="using:SshAgentEcho.Gui.ViewModels"
        x:DataType="vm:MainViewModel"
        Title="ssh-agent-echo"
        Icon="/Assets/icon.png"
        MinWidth="600"
        MinHeight="600"
        Width="600"
        Background="#1E1E1E">

        <Border Padding="16">
                <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Service Control Card -->
                        <Border Grid.Row="0" Background="#2A2A2A"
                                CornerRadius="8"
                                Padding="16">
                                <Grid
                                ColumnSpacing="16"
                                RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Service Status:"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CCCCCC" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   FontWeight="Bold"
                                                   Foreground="#FF6B6B"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                <Button Content="Start"
                                                        Command="{Binding StartCommand}" />
                                                <Button Content="Stop"
                                                        Command="{Binding StopCommand}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="Controls the background synchronization service."
                                                   Foreground="#888888"
                                                   FontSize="12" />
                                </Grid>
                        </Border>

                        <!-- Sync Settings Card -->
                        <Border Grid.Row="1" Background="#2A2A2A"
                                CornerRadius="8"
                                Padding="16">
                                <Grid
                                ColumnSpacing="12"
                                VerticalAlignment="Center">

                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Sync every"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CCCCCC" />


                                        <NumericUpDown Grid.Column="1"
                                                       Increment="1"
                                                       FormatString="0 mins"
                                                       Minimum="5"
                                                       Maximum="60"
                                                       HorizontalContentAlignment="Center"
                                                       Value="{Binding SettingsService.Current.SyncIntervalMinutes, Mode=TwoWay}" />

                                        <Button Grid.Column="2"
                                                Content="Reset"
                                                Click= "ResetSettings_Click" />

                                        <Button Grid.Column="3"
                                                Content="Save"
                                                Click="SaveSettings_Click" />

                                        <!-- Spacer column -->
                                        <Border Grid.Column="4" />

                                        <Button Grid.Column="5"
                                                Content="Force Sync"
                                                Command="{Binding SyncCommand}" />
                                </Grid>
                        </Border>

                        <!-- Start At Boot Settings Card -->
                        <Border Grid.Row="2" Background="#2A2A2A"
                                CornerRadius="8"
                                Padding="16">
                                <Grid
                                ColumnSpacing="12"
                                VerticalAlignment="Center">

                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Start at boot"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CCCCCC" />

                                        <CheckBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsStartAtBootEnabled}" />

                                        <!-- Spacer column -->
                                        <Border Grid.Column="2" />
                                </Grid>
                        </Border>

                        <!-- Log Section -->
                        <Border Grid.Row="3" Background="#2A2A2A"
                                CornerRadius="8"
                                Padding="12">

                                <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>   <!-- Label sizes to content -->
                                                <RowDefinition Height="*"/>      <!-- TextBox fills remaining space -->
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="Event Log"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF" />

                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding LogEntries}"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 Background="#1B1B1B"
                                                 Foreground="#D0D0D0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                </Grid>
                        </Border>
                </Grid>
        </Border>
</Window>